<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- CUDA Compiler Settings -->
    <CudaPath Condition="'$(CudaPath)' == ''">C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.0</CudaPath>
    <NvccPath>$(CudaPath)\bin\nvcc.exe</NvccPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedCuda" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- Collect all CUDA source files -->
  <ItemGroup>
    <CudaKernel Include="CU\*.cu" />
  </ItemGroup>

  <!-- PTX files to copy to output -->
  <ItemGroup>
    <None Include="CU\*.ptx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Compile CUDA kernels to PTX before build -->
  <Target Name="CompileCudaKernels" BeforeTargets="BeforeBuild" Inputs="@(CudaKernel)" Outputs="@(CudaKernel->'%(RootDir)%(Directory)%(Filename).ptx')">
    <Message Importance="high" Text="Compiling CUDA kernels..." />
    <Exec Command="&quot;$(NvccPath)&quot; -ptx -allow-unsupported-compiler -o &quot;%(CudaKernel.RootDir)%(CudaKernel.Directory)%(CudaKernel.Filename).ptx&quot; &quot;%(CudaKernel.FullPath)&quot;"
          Condition="Exists('$(NvccPath)')" />
    <Warning Text="CUDA compiler (nvcc) not found at $(NvccPath). CUDA kernels will not be compiled. Set CudaPath property to your CUDA installation directory."
             Condition="!Exists('$(NvccPath)')" />
  </Target>

</Project>
